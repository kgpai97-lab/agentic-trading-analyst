# Copy this file to .env and fill in the values for your chosen LLM provider.
# .env is git-ignored; .env.example is the shareable template (no secrets).
#
# Any flat config key in agentic/default_config.py can be overridden here with
# the `agentic_` prefix (e.g. agentic_LLM_PROVIDER=openai). Env vars win over
# DEFAULT_CONFIG.

# ── Option 1: Ollama (default) ──────────────────────────────────────────────
# Local server:
OLLAMA_BASE_URL=http://localhost:11434
agentic_OLLAMA_BASE_URL=http://localhost:11434
# Pick any model you've pulled locally, e.g. llama3.2:3b:
agentic_QUICK_THINK_LLM=llama3.2:3b
agentic_DEEP_THINK_LLM=llama3.2:3b
agentic_QUICK_REASONING=false
agentic_DEEP_REASONING=true
#
# Ollama-cloud instead of local: point the base URL at https://ollama.com,
# set OLLAMA_API_KEY to your Ollama key, and use a :cloud model name.
# OLLAMA_API_KEY=your-ollama-key-here

# ── Option 2: a hosted API (Claude / OpenAI / Google) ───────────────────────
# See docs/SWITCHING_LLM_PROVIDERS.md for the full walkthrough. Example (Claude):
# agentic_LLM_PROVIDER=anthropic
# agentic_DEEP_THINK_LLM=claude-opus-4-8
# agentic_QUICK_THINK_LLM=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=sk-ant-...
#
# (OpenAI: OPENAI_API_KEY + agentic_LLM_PROVIDER=openai;
#  Google: GOOGLE_API_KEY + agentic_LLM_PROVIDER=google)

# ── Optional: LangSmith tracing (off by default) ────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agentic-trading-analyst
